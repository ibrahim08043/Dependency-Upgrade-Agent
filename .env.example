# ============================================================================
# Dependency Upgrade Agent — environment configuration
#
# Copy this file to the appropriate location for each process.
# Backend secrets MUST NOT be prefixed VITE_/NEXT_PUBLIC_ — they are read only
# by the backend and are never exposed to the browser.
# ============================================================================

# ----------------------------------------------------------------------------
# Backend (backend/.env)
# ----------------------------------------------------------------------------

# Port the Express API listens on. Defaults to 8000 when unset.
PORT=8000

# Optional. Comma-separated list of allowed browser origins for CORS.
# Defaults to http://localhost:5173 (the Vite dev server).
FRONTEND_ORIGIN=http://localhost:5173

# --- AI provider selection ---
# Optional. Forces a specific provider: "gemini" | "groq" | "xai".
# When unset, the backend auto-detects from whichever API key is configured
# (GEMINI_API_KEY -> Gemini; otherwise the OpenAI-compatible slot below).
# AI_PROVIDER=gemini

# --- xAI / Groq (OpenAI-compatible) ---
# xAI (api.x.ai) or Groq (api.groq.com). A gsk_ prefix targets Groq; xai- targets xAI.
# Without it, migration jobs fail with GROK_NOT_CONFIGURED instead of faking a response.
# Obtain an xAI key from https://console.x.ai/ or a Groq key from https://console.groq.com/
XAI_API_KEY=your-grok-or-xai-api-key-here
# Optional. Same secret slot, alternative name. Either XAI_API_KEY or GROQ_API_KEY is used.
# GROQ_API_KEY=your-groq-api-key-here
# Optional. Override the default model used by the OpenAI-compatible provider.
# XAI_MODEL=grok-4-latest

# --- Gemini (Google AI Studio) ---
# Optional. When set (and AI_PROVIDER=gemini), the coding agent runs on Gemini.
# Obtain a key from https://aistudio.google.com/apikey
# GEMINI_API_KEY=your-gemini-api-key-here
# Optional. Override the default Gemini model (defaults to gemini-2.5-flash).
# GEMINI_MODEL=gemini-2.5-flash

# Optional. Improves private GitHub repository analysis.
GITHUB_TOKEN=

# Log level for the backend logger (trace|debug|info|warn|error|fatal).
LOG_LEVEL=info

# ----------------------------------------------------------------------------
# Frontend (frontend/.env)
# ----------------------------------------------------------------------------

# Backend origin used by the frontend API client.
# In Vite dev this is not required — /api requests are proxied to
# http://localhost:8000 automatically (see frontend/vite.config.ts).
# Set it when serving a static build from a different origin than the API.
VITE_API_URL=http://localhost:8000

# Vite dev server port. Defaults to 5173.
# PORT=5173