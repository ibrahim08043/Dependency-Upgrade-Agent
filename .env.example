# ============================================================================
# Dependency Upgrade Agent — environment configuration
#
# Copy this file to the appropriate location for each process.
# Backend secrets MUST NOT be prefixed VITE_/NEXT_PUBLIC_ — they are read only
# by the backend and are never exposed to the browser.
# ============================================================================

# ----------------------------------------------------------------------------
# Backend (backend/.env)
# ----------------------------------------------------------------------------

# Port the Express API listens on. Defaults to 8000 when unset.
PORT=8000

# Optional. Comma-separated list of allowed browser origins for CORS.
# Defaults to http://localhost:5173 (the Vite dev server).
FRONTEND_ORIGIN=http://localhost:5173

# Required for Grok migration planning. Without it, migration jobs fail with
# GROK_NOT_CONFIGURED instead of faking a response.
XAI_API_KEY=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
# Optional. Override the default Grok model used by the agent.
# XAI_MODEL=grok-4-latest

# Optional. Improves private GitHub repository analysis.
GITHUB_TOKEN=

# Log level for the backend logger (trace|debug|info|warn|error|fatal).
LOG_LEVEL=info

# ----------------------------------------------------------------------------
# Frontend (frontend/.env)
# ----------------------------------------------------------------------------

# Backend origin used by the frontend API client.
# In Vite dev this is not required — /api requests are proxied to
# http://localhost:8000 automatically (see frontend/vite.config.ts).
# Set it when serving a static build from a different origin than the API.
VITE_API_URL=http://localhost:8000

# Vite dev server port. Defaults to 5173.
# PORT=5173